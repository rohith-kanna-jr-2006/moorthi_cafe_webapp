# Dependencies
node_modules/
backend/node_modules/

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
backend/.env
backend/.env.*
backend/.env.local
backend/.env.development.local
backend/.env.test.local
backend/.env.production.local
!backend/.env.example

# Private Keys & Certificates
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt

# Database Backups & Dumps (Sensitive: contains user credentials & customer orders)
backups/
backend/backups/
data/
*.dump
*.backup
*.sqlite
*.db

# Runtime User Uploads (Ignore uploaded images, keep directory via .gitkeep)
backend/public/images/uploads/*
!backend/public/images/uploads/.gitkeep
public/images/uploads/*
!public/images/uploads/.gitkeep

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/
backend/logs/

# Test Coverage & Temp
coverage/
.nyc_output/
*.tmp
*.bak
.temp/
.cache/

# Build Output
dist/
build/

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Playwright generated artifacts
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
.playwright-mcp/
home_desktop*
screenshots/
screenshot*/
