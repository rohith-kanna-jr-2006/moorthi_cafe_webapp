.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

backend/.env
backend/.env.*
backend/.env.local
backend/.env.development.local
backend/.env.test.local
backend/.env.production.local
!backend/.env.example

