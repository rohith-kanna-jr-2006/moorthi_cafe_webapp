            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chidambaram Kothu Parotta (Veg)\",\n  \"description\": \"Shredded flaky parottas tossed with country vegetables and salna\",\n  \"price\": 150.0,\n  \"category\": \"{{categoryId}}\",\n  \"portion\": \"1 Plate\",\n  \"prepTimeMinutes\": 10,\n  \"tags\": [\"special\", \"dinner\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/foods",
              "host": ["{{baseUrl}}"],
              "path": ["foods"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Customer Cannot Create Food (Expect 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
