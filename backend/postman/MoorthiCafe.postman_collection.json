                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. List Foods with Search & Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/foods?search=Dosa",
              "host": ["{{baseUrl}}"],
              "path": ["foods"],
              "query": [{ "key": "search", "value": "Dosa" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
