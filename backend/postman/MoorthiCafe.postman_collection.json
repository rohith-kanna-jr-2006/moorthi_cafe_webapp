              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"customer@moorthicafe.com\",\n  \"phone\": \"9876500000\",\n  \"password\": \"ExampleStrongPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 Conflict', function () { pm.response.to.have.status(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
