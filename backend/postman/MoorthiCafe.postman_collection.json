{
  "info": {
    "_postman_id": "902dca12-moorthi-cafe-collection-v1",
    "name": "Hotel New Moorthi Cafe API",
    "description": "Comprehensive Postman test collection for Hotel New Moorthi Cafe (Chidambaram). Includes 34 test scenarios covering Auth, Menu, Cart/Billing, Concurrency Tokens, and Admin Operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. System Health",
      "item": [
        {
          "name": "Health Check Diagnostic",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Database reports CONNECTED', function () { var json = pm.response.json(); pm.expect(json.data.database).to.eql('CONNECTED'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "1. Valid Customer Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sundaram Natarajan\",\n  \"email\": \"sundaram_{{$timestamp}}@chidambaram.in\",\n  \"phone\": \"+91 98765 43210\",\n  \"password\": \"ExampleStrongPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) { pm.environment.set('customerToken', json.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Duplicate Email Signup (Expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
