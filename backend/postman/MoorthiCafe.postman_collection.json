    {
      "name": "4. Orders & Billing",
      "item": [
        {
          "name": "1. Preview Pricing Calculation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"foodId\": \"{{foodId}}\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/preview",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "preview"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.data.subtotal).to.be.above(0);",
                  "pm.expect(json.data.packagingCharge).to.eql(15);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Submit Order (Immediate Pickup)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Idempotency-Key", "value": "order-postman-{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"foodId\": \"{{foodId}}\", \"quantity\": 1 }\n  ],\n  \"pickupType\": \"IMMEDIATE\",\n  \"notes\": \"Crisp roast, extra sambar pack\",\n  \"paymentMethod\": \"UPI\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.data.order.dailyTokenNumber).to.be.above(0);",
                  "pm.environment.set('orderId', json.data.order._id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
