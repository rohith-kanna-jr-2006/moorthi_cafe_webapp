# =====================================================================
# Hotel New Moorthi Cafe — Environment Configuration Template
# =====================================================================
# INSTRUCTIONS:
# Copy this file to .env in local root or within respective sub-packages:
#   cp .env.example .env
#   cp .env.example backend/.env
# NEVER commit .env or secrets to Git version control.
# =====================================================================

# ---------------------------------------------------------------------
# Backend Configuration (Node.js + Express)
# ---------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Database connection string (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/moorthi_cafe

# Authentication (JWT Secret key - replace with minimum 32 random characters)
JWT_SECRET=replace_with_a_long_secure_random_secret_for_development
JWT_EXPIRES_IN=7d

# Allowed frontend origins for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# Restaurant Business Operating Parameters (Asia/Kolkata timezone)
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_OPEN_TIME=06:00
BUSINESS_CLOSE_TIME=22:30
MIN_PREPARATION_MINUTES=15
MAX_ADVANCE_BOOKING_DAYS=2

# Taxes and Charges (Configurable owner settings)
PACKAGING_CHARGE=15
GST_PERCENTAGE=5

# ---------------------------------------------------------------------
# Frontend Configuration (React + Vite)
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
